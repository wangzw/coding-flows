#!/usr/bin/env bash
# coding-flows-worktree-create <branch> [<base-ref>]
#
# Create a managed worktree for <branch>, branched from <base-ref> (default:
# origin/HEAD or origin/main). Echoes the worktree's absolute path on stdout.
# Caller is expected to `cd` into that path for subsequent operations.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/worktree.sh
source "$SCRIPT_DIR/lib/worktree.sh"

if [[ $# -lt 1 ]]; then
  echo "Usage: coding-flows-worktree-create <branch> [<base-ref>]" >&2
  exit 64
fi

worktree_create "$@"
