#!/usr/bin/env bash
# coding-flows-verify-lgtm-coverage <PR> | --from-file <pr-view-json>
#
# Asserts the most recent /lgtm comments enumerate every AC ID in the AC
# mapping table and every invariant triggered by the diff.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/check-lgtm.sh
source "$SCRIPT_DIR/lib/check-lgtm.sh"
# shellcheck source=lib/verify-ac-mapping.sh
source "$SCRIPT_DIR/lib/verify-ac-mapping.sh"
# shellcheck source=lib/verify-risks.sh
source "$SCRIPT_DIR/lib/verify-risks.sh"
# shellcheck source=lib/verify-lgtm-coverage.sh
source "$SCRIPT_DIR/lib/verify-lgtm-coverage.sh"

main() {
  load_pr_view "$@"
  verify_lgtm_coverage "$PR_VIEW_JSON"
}

main "$@"
