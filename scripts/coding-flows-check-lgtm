#!/usr/bin/env bash
# coding-flows-check-lgtm <PR> | --from-file <pr-view-json>
#
# Validates the most recent /lgtm comment on a PR. See
# references/scripts.md for exit-code semantics.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/check-lgtm.sh
source "$SCRIPT_DIR/lib/check-lgtm.sh"

main() {
  load_pr_view "$@"
  check_lgtm "$PR_VIEW_JSON"
}

main "$@"
