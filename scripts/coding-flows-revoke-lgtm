#!/usr/bin/env bash
# coding-flows-revoke-lgtm <PR> --reviewer <id> -m "<body>"
# coding-flows-revoke-lgtm <PR> --reviewer <id> --body-file <path>
# coding-flows-revoke-lgtm <PR> --reviewer <id> [-m ...] --dry-run
#
# Revoke a prior /lgtm by posting a top-level PR comment carrying a
# `<!-- coding-flows:revoke-lgtm reviewer=<id> -->` marker. The marker
# supersedes any earlier /lgtm from the same reviewer at the
# `check-lgtm` level — see scripts/lib/check-lgtm.sh.
#
# Why a comment instead of `gh pr review --request-changes`:
#   - In self-PR mode (Coder and all reviewers share one gh login),
#     GitHub rejects `gh pr review --request-changes` with "Pull
#     request cannot be reviewed by the author".
#   - Top-level comments are always allowed and carry our marker without
#     friction.
#   - Gate 4/5 in coding-flows-merge use `check-lgtm`, which now honors
#     revoke markers — so the revocation reliably blocks merge.
#
# The reviewer must use the same identifier they used in the original
# /lgtm marker (typically "r1", or "r2" for dual-review high-risk PRs).
# Otherwise the supersession doesn't match.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

usage() {
  cat <<'EOF' >&2
Usage:
  coding-flows-revoke-lgtm <PR> --reviewer <id> -m "<body>"
  coding-flows-revoke-lgtm <PR> --reviewer <id> --body-file <path>
  coding-flows-revoke-lgtm <PR> --reviewer <id> [...] --dry-run

Posts a top-level PR comment with a revoke marker. The marker supersedes
the prior /lgtm at check-lgtm level (a fresh /lgtm posted later will
re-supersede). Works in self-PR mode where `gh pr review
--request-changes` would be rejected.

The reviewer id must match the id used in the original /lgtm marker.
EOF
  exit 64
}

main() {
  local pr=""
  local reviewer=""
  local body=""
  local body_file=""
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reviewer)          reviewer="$2"; shift 2 ;;
      -m|--message|--body) body="$2"; shift 2 ;;
      --body-file)         body_file="$2"; shift 2 ;;
      --dry-run)           dry_run=1; shift ;;
      -h|--help)           usage ;;
      *)
        if [[ -z "$pr" && "$1" =~ ^[0-9]+$ ]]; then
          pr="$1"; shift
        else
          usage
        fi
        ;;
    esac
  done

  [[ -z "$pr" ]] && usage
  [[ -z "$reviewer" ]] && { log_error "missing --reviewer <id>"; usage; }

  if [[ -n "$body_file" ]]; then
    [[ -f "$body_file" ]] || { log_error "no such file: $body_file"; exit 64; }
    body="$(cat "$body_file")"
  fi
  [[ -z "$body" ]] && { log_error "missing -m <body> or --body-file"; usage; }

  # Assemble the comment: marker on its own line (parsable from the body),
  # then a human-readable lead-in, then the user's findings.
  local comment_body
  comment_body="$(printf '<!-- coding-flows:revoke-lgtm reviewer=%s -->\n**Revoking prior /lgtm.** %s\n' \
    "$reviewer" "$body")"

  if [[ $dry_run -eq 1 ]]; then
    printf 'DRY_RUN=yes\nPR=%s\nREVIEWER=%s\nACTION=comment-with-revoke-marker\nBODY_BYTES=%d\n' \
      "$pr" "$reviewer" "${#comment_body}"
    return 0
  fi

  gh pr comment "$pr" --body "$comment_body"
  log_info "posted revoke marker on PR #$pr (reviewer=$reviewer); prior /lgtm now superseded by check-lgtm"
}

main "$@"
