#!/usr/bin/env bash
# coding-flows-verify-ac-mapping <PR> | --from-file <pr-view-json>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/verify-ac-mapping.sh
source "$SCRIPT_DIR/lib/verify-ac-mapping.sh"

main() {
  load_pr_view "$@"
  local body
  body="$(jq -r '.body // ""' <<<"$PR_VIEW_JSON")"
  verify_ac_mapping "$body" "$PR_VIEW_JSON"
}

main "$@"
