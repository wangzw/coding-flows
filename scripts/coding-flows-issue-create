#!/usr/bin/env bash
# coding-flows-issue-create [<gh issue create args...>]
#
# Wraps `gh issue create` and guarantees --assignee @me lands on the new
# issue. Same rationale as coding-flows-pr-create: the Coder's Phase A
# `gh issue list --assignee @me` cannot see un-assigned issues, and the
# cycle output's full-coverage rule then misses them.
#
# Observed regressions: issues #418, #420, #422, #430, #432 created
# un-assigned across one session despite multiple doc-only fixes. This
# script enforces the rule at the call site.
#
# Pass-through: every flag accepted by `gh issue create` works here.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

ISSUE_URL="$(gh issue create "$@" --assignee @me)"
if [[ -z "$ISSUE_URL" ]]; then
  log_error "issue-create: gh issue create returned empty output"
  exit 69
fi
ISSUE_NUM="${ISSUE_URL##*/}"

if [[ -z "$(gh issue view "$ISSUE_NUM" --json assignees --jq '.assignees[].login' 2>/dev/null | head -n1)" ]]; then
  log_info "issue-create: --assignee @me did not stick; using fallback edit"
  gh issue edit "$ISSUE_NUM" --add-assignee @me >/dev/null \
    || log_warn "issue-create: gh issue edit --add-assignee fallback also failed"
fi

printf '%s\n' "$ISSUE_URL"
